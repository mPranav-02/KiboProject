# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY — placeholder values for docker compose on your machine.
# Copy to .env (gitignored) and change the passwords. NEVER use these anywhere shared.
# ---------------------------------------------------------------------------

# MySQL (host "mysql" is the docker compose service name)
DB_URL=jdbc:mysql://mysql:3306/kibo
DB_USERNAME=kibo_local
DB_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-local-root-only

# Redis (cache only)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-local-only

# RabbitMQ (lifecycle events only)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=kibo_local
RABBITMQ_PASSWORD=change-me-local-only

# Optional messaging overrides (defaults live in application.yml; see docs/messaging-rabbitmq.md):
# KIBO_MESSAGING_ENABLED=true
# KIBO_MESSAGING_EXCHANGE=kibo.holds
# KIBO_MESSAGING_AUDIT_QUEUE=kibo.holds.audit
# KIBO_MESSAGING_AUDIT_CONSUMER_ENABLED=true

# Optional business overrides (defaults live in application.yml), e.g. for the expiry demo:
# KIBO_HOLD_DURATION=PT20S
