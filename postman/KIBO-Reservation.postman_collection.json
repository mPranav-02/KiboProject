    {
      "name": "3. Rejections & validation",
      "item": [
        {
          "name": "Same key, different quantity → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "{{customerId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{runId}}-main"
              },
