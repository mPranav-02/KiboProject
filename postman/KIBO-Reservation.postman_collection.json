            "body": {
              "mode": "raw",
              "raw": "{\"quantity\": 2}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The single-unit drop has 1 unit in total, so 2 can never be granted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code INSUFFICIENT_INVENTORY\", () => pm.expect(pm.response.json().code).to.eql(\"INSUFFICIENT_INVENTORY\"));",
                  "pm.test(\"reports what is available\", () => pm.expect(pm.response.json()).to.have.property(\"availableQuantity\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upcoming drop → 409 DROP_NOT_RELEASED",
          "request": {
            "method": "POST",
            "header": [
              {
