                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code IDEMPOTENCY_KEY_CONFLICT\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_CONFLICT\"));",
                  "pm.test(\"problem+json body\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); pm.expect(pm.response.json()).to.have.property(\"timestamp\"); });"
                ]
