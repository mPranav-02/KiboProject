{
  "info": {
    "name": "KIBO Limited Drop Reservation",
    "_postman_id": "6f1a3f0e-2b7c-4d5e-9a10-4b1b0c0d0001",
    "description": "All endpoints of the KIBO reservation service with assertions.\n\n1. `docker compose up --build`\n2. Import this collection and click **Run** (folders 0-3 run in order; each run uses fresh idempotency keys).\n3. Folder 4 needs `KIBO_HOLD_DURATION=PT20S` in `.env`; otherwise its checks are skipped.\n\nDrop ids match the startup seed on an empty database: 1 = 50 units, 3 = single unit, 4 = opens 10 min after startup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/readiness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));",
                  "// A fresh run id per collection run, so idempotency keys never collide with an earlier run.",
                  "pm.collectionVariables.set(\"runId\", \"run-\" + Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "Health with components",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Shows db, redis and rabbit separately. Readiness depends on the database only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Drops",
      "item": [
        {
          "name": "List drops",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/drops",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "drops"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const drops = pm.response.json();",
                  "pm.test(\"seeded drops are listed\", () => pm.expect(drops.length).to.be.at.least(4));",
                  "pm.test(\"each drop has live availability\", () => drops.forEach(d => pm.expect([\"UPCOMING\",\"OPEN\",\"SOLD_OUT\"]).to.include(d.availabilityStatus)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one drop",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/drops/{{openDropId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "drops",
                "{{openDropId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"has the drop fields\", () => pm.expect(d).to.include.keys(\"id\",\"name\",\"totalQuantity\",\"availableQuantity\",\"maxPerHold\",\"startsAt\",\"availabilityStatus\"));",
                  "pm.collectionVariables.set(\"availableBefore\", d.availableQuantity);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the upcoming drop",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/drops/{{upcomingDropId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "drops",
                "{{upcomingDropId}}"
              ]
            },
            "description": "Seeded to open 10 minutes after startup; stored so the DROP_NOT_RELEASED check knows whether it still applies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"upcomingStatus\", pm.response.json().availabilityStatus);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown drop → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/drops/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "drops",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"code DROP_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"DROP_NOT_FOUND\"));",
                  "pm.test(\"problem+json body\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); pm.expect(pm.response.json()).to.have.property(\"timestamp\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
