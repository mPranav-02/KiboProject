                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/drops/{{openDropId}}/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "drops",
                "{{openDropId}}",
                "holds"
              ]
            },
            "body": {
