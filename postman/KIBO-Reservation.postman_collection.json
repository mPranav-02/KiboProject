    {
      "name": "4. Expiry (needs short holds)",
      "description": "Start the stack with KIBO_HOLD_DURATION=PT20S in .env (then `docker compose up -d --wait`). Run this folder on its own or with the rest. It places a fresh hold, waits until it has expired (about 24 s), then checks it is EXPIRED and can't be confirmed. With the default 5-minute holds the checks are skipped.",
      "item": [
        {
          "name": "Place a hold to let expire",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "{{customerId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{expireKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/drops/{{openDropId}}/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "drops",
                "{{openDropId}}",
                "holds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"quantity\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new key on every send, so this never replays an older hold (e.g. one made before holds were shortened).",
                  "pm.collectionVariables.set(\"expireKey\", \"expire-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.collectionVariables.set(\"expireHoldId\", h.id);",
                  "const ms = new Date(h.expiresAt) - new Date(h.createdAt);",
                  "pm.collectionVariables.set(\"expiryWaitMs\", ms <= 60000 ? ms + 4000 : -1);"
                ]
              }
            }
          ]
        },
        {
          "name": "After expiry: GET → EXPIRED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "{{customerId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/holds/{{expireHoldId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "holds",
                "{{expireHoldId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get(\"expiryWaitMs\")) < 0 && pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
                  "const wait = Number(pm.collectionVariables.get(\"expiryWaitMs\"));",
                  "if (wait > 0) { setTimeout(() => {}, wait); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get(\"expiryWaitMs\")) < 0) {",
                  "  pm.test.skip(\"hold duration is over 60 s; set KIBO_HOLD_DURATION=PT20S to run the expiry checks\", () => {});",
                  "} else {",
                  "  pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "  pm.test(\"status is EXPIRED\", () => pm.expect(pm.response.json().status).to.eql(\"EXPIRED\"));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm after expiry → 409 HOLD_EXPIRED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Customer-Id",
                "value": "{{customerId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/holds/{{expireHoldId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "holds",
                "{{expireHoldId}}",
                "confirm"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get(\"expiryWaitMs\")) < 0 && pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (Number(pm.collectionVariables.get(\"expiryWaitMs\")) < 0) {",
                  "  pm.test.skip(\"hold duration is over 60 s\", () => {});",
                  "} else {",
                  "  pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "  pm.test(\"code HOLD_EXPIRED\", () => pm.expect(pm.response.json().code).to.eql(\"HOLD_EXPIRED\"));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
