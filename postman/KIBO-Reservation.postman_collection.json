          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.test(\"ACTIVE with an expiry\", () => { pm.expect(h.status).to.eql(\"ACTIVE\"); pm.expect(h.expiresAt).to.be.a(\"string\"); });",
                  "pm.test(\"Location header points at the hold\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/holds/\" + h.id));",
                  "pm.collectionVariables.set(\"holdId\", h.id);"
